{
  "name": "protohub-desktop",
  "version": "1.0.0",
  "description": "ProtoHub - Product Manager Prototype & Annotation Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "package": "electron-packager . ProtoHub --platform=win32 --arch=x64 --out=dist --overwrite",
    "build:electron": "electron-builder --win --dir --x64",
    "build": "echo 'Static site build complete'"
  },
  "keywords": [
    "prototype",
    "annotation",
    "prd",
    "sdd",
    "electron"
  ],
  "author": "ProtoHub Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^5.6.0"
  },
  "build": {
    "appId": "com.protohub.desktop",
    "productName": "ProtoHub",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "identity": null,
      "category": "public.app-category.productivity"
    }
  }
}
